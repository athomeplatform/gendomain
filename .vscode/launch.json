  "version": "0.2.0",
  "configurations": [
    {
      "name": "DEBUG",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "cwd": "${workspaceFolder}/",
      "program": "${workspaceFolder}/",
      "args": [
        "--sqltype=mysql",
        "athome:p@ssword@localhost:3660/athome",
        "--database=athome",
        "--model=domain",
        "--out=_generate/code/",
        "--custom-annotation",
        "--json",
        "--json-fmt=lower_camel",
        "--gorm",
        "--overwrite"
      ]
    }
  ]
}
